  <item><title>About Us</title><dc:creator><![CDATA[cbcsc-demo]]></dc:creator><content:encoded><![CDATA[<p>The Canadian Baloch Cultural and Social Community celebrates, preserves, and promotes Baloch culture, heritage, and traditions within Canada. We create a welcoming place for Baloch Canadians and everyone interested in learning about Baloch culture.</p><h2>Our commitment</h2><p>We preserve cultural heritage, foster social connections, promote cultural exchange, and support community development.</p>]]></content:encoded><wp:post_id>102</wp:post_id><wp:post_date>2026-09-15 12:01:00</wp:post_date><wp:post_name>about</wp:post_name><wp:status>publish</wp:status><wp:post_type>page</wp:post_type><wp:post_parent>0</wp:post_parent><wp:menu_order>0</wp:menu_order></item>
